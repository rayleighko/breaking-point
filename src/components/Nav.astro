---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { url } from '@/lib/url';

const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path.startsWith(url(href).replace(/\/$/, ''));
---

<header class="nav">
  <div class="wrap-wide nav-inner">
    <a href={url('/')} class="brand">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">Breaking&nbsp;Point</span>
    </a>
    <nav class="links" aria-label="주요 메뉴">
      <a href={url('/labs')} class:list={[{ on: isActive('/labs') }]}>실험실</a>
      <a href={url('/topics')} class:list={[{ on: isActive('/topics') }]}>주제</a>
      <a href={url('/playground')} class:list={[{ on: isActive('/playground') }]}>Playground</a>
      <a href={url('/search')} class:list={[{ on: isActive('/search') }]}>검색</a>
      <a href={url('/ai')} class:list={[{ on: isActive('/ai') }]}>AI 코치</a>
      <a href={url('/roadmap')} class:list={[{ on: isActive('/roadmap') }]}>로드맵</a>
      <a href="https://github.com/rayleighko/breaking-point" target="_blank" rel="noopener"
        >GitHub</a
      >
    </nav>
    <div class="nav-actions">
      <ThemeToggle />
      <div class="mobile-menu">
        <button type="button" aria-expanded="false" aria-controls="mobile-navigation">메뉴</button>
        <nav id="mobile-navigation" aria-label="모바일 메뉴" hidden>
          <a href={url('/labs')}>실험실</a>
          <a href={url('/topics')}>주제</a>
          <a href={url('/playground')}>Playground</a>
          <a href={url('/search')}>검색</a>
          <a href={url('/ai')}>AI 코치</a>
          <a href={url('/roadmap')}>로드맵</a>
          <a href="https://github.com/rayleighko/breaking-point">GitHub ↗</a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('.mobile-menu');
  const button = menu?.querySelector<HTMLButtonElement>('button');
  const panel = menu?.querySelector<HTMLElement>('nav');

  const closeMenu = () => {
    if (!button || !panel) return;
    button.setAttribute('aria-expanded', 'false');
    panel.hidden = true;
  };

  button?.addEventListener('click', () => {
    if (!panel) return;
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
  });
  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });
  document.addEventListener('click', (event) => {
    if (menu && !menu.contains(event.target as Node)) closeMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
      button?.focus();
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 54px;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .mobile-menu {
    display: none;
    position: relative;
  }
  .mobile-menu > button {
    display: grid;
    place-items: center;
    min-height: 36px;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--fg-muted);
    font-size: 0.78rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: grid;
    width: min(220px, calc(100vw - 2rem));
    padding: 0.45rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-card);
    box-shadow: var(--shadow-lg);
  }
  .mobile-menu nav[hidden] {
    display: none;
  }
  .mobile-menu nav a {
    padding: 0.55rem 0.65rem;
    border-radius: 7px;
    color: var(--fg-muted);
    font-size: 0.86rem;
  }
  .mobile-menu nav a:hover {
    background: var(--bg-soft);
    color: var(--fg);
    text-decoration: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-weight: 700;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bad);
    box-shadow: 0 0 10px var(--bad);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }
  .brand-text {
    letter-spacing: -0.03em;
  }
  .links {
    display: flex;
    gap: 1.15rem;
    font-size: 0.92rem;
  }
  .links a {
    color: var(--fg-muted);
  }
  .links a.on {
    color: var(--fg);
  }
  @media (max-width: 760px) {
    .links {
      display: none !important;
    }
    .mobile-menu {
      display: block;
    }
  }
</style>
