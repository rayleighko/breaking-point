---
import { getCollection, render } from 'astro:content';

import LabLayout from '@/layouts/LabLayout.astro';

import type { InferGetStaticPropsType } from 'astro';

export async function getStaticPaths() {
  const labs = await getCollection('labs', ({ data }) => !data.draft);
  return labs.map((lab) => ({ params: { slug: lab.id }, props: { lab } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { lab } = Astro.props as Props;
const { Content } = await render(lab);
const d = lab.data;
---

<LabLayout
  title={d.title}
  subtitle={d.subtitle}
  question={d.question}
  level={d.level}
  minutes={d.minutes}
  tags={d.tags}
>
  <Content />
</LabLayout>
