---
import Base from '@/layouts/Base.astro';
import { ROADMAP, STATUS_LABEL, counts } from '@/lib/roadmap';
import { DELIVERY_STEPS, LAB_OPS_LINKS, SYSTEM_LAYERS } from '@/lib/system-map';
import { url } from '@/lib/url';

const { done, total } = counts();
---

<Base title="로드맵 — Breaking Point">
  <div class="wrap-wide page">
    <h1>로드맵</h1>
    <p class="muted">
      backend 병목에서 시작해 application, cloud, delivery와 AI-assisted engineering까지 이어집니다.
      모든 코드를 외우는 순서가 아니라, 한 결정이 전체 system에 미치는 영향을 설명하는 순서입니다.
    </p>
    <div class="bar" role="img" aria-label={`${total}개 중 ${done}개 완성`}>
      <i style={`width:${(done / total) * 100}%`}></i>
    </div>
    <p class="dim count">{done} / {total} 완성</p>

    <section class="sysmap" aria-labelledby="sysmap-title">
      <h2 id="sysmap-title">이 서비스는 어떤 구조인가요?</h2>
      <p class="goal muted">
        Breaking Point 자체의 runtime 경계와 운영 loop입니다. lab에서 다루는 Queue, p99, overload
        감각을 이 repository를 만드는 방식에도 같은 언어로 연결합니다. 자세한 설명은
        <a href={url('/process')}>프로세스</a>와
        <a href="https://github.com/rayleighko/breaking-point/blob/main/docs/ARCHITECTURE.md"
          >Architecture</a
        >를 봅니다.
      </p>

      <h3 class="sys-h">Runtime layers</h3>
      <div class="arch" role="list">
        {
          SYSTEM_LAYERS.map((layer, index) => (
            <div class="arch-node" role="listitem">
              <span class="arch-n">{index + 1}</span>
              <div>
                <b>{layer.name}</b>
                <span class="dim standing">{layer.standing}</span>
                <p>{layer.role}</p>
              </div>
            </div>
          ))
        }
      </div>

      <h3 class="sys-h">Delivery loop</h3>
      <ol class="flow" aria-label="feature 공개 흐름">
        {
          DELIVERY_STEPS.map((step) => (
            <li>
              <b>{step.name}</b>
              <span>{step.detail}</span>
            </li>
          ))
        }
      </ol>

      <h3 class="sys-h">랩 개념 → 운영 감각</h3>
      <div class="ops">
        {
          LAB_OPS_LINKS.map((item) => (
            <div class="ops-row">
              <b>
                {item.labSlug ? (
                  <a href={url(`/labs/${item.labSlug}`)}>{item.concept}</a>
                ) : (
                  item.concept
                )}
              </b>
              <span class="muted">{item.opsAnalogy}</span>
            </div>
          ))
        }
      </div>
    </section>

    {
      ROADMAP.map((stage) => (
        <section class="stage">
          <h2>{stage.name}</h2>
          <p class="goal muted">{stage.goal}</p>
          <div class="items">
            {stage.items.map((i) => (
              <div class="item" data-s={i.status}>
                <span class="badge">{STATUS_LABEL[i.status]}</span>
                <div class="item-b">
                  <div class="item-t">
                    {i.slug ? (
                      <a href={url(`/labs/${i.slug}`)}>
                        <b>{i.title}</b>
                      </a>
                    ) : (
                      <b>{i.title}</b>
                    )}
                  </div>
                  <div class="item-q muted">{i.question}</div>
                  <div class="item-s dim">🎛 {i.sim}</div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section class="contrib">
      <h2>같이 만들고 싶다면</h2>
      <p>
        설명이 틀렸거나 simulation이 현실과 다르다면 Issue로 알려주세요. 새 랩은 구현 전에 현상,
        실패해야 하는 순진한 해법, challenge constraint와 validation plan을 Proposal로 합의합니다.
      </p>
      <p>
        <a href="https://github.com/rayleighko/breaking-point/blob/main/CONTRIBUTING.md"
          >Contribution guide →</a
        >
      </p>
    </section>
  </div>
</Base>

<style>
  .page {
    padding: 2.8rem 1.25rem 0;
  }
  .bar {
    height: 6px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    margin-top: 1.6rem;
  }
  .bar > i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--ok));
  }
  .count {
    font-size: 0.84rem;
    margin-top: 0.4rem;
  }
  .stage h2 {
    font-size: 1.25rem;
  }
  .goal {
    font-size: 0.93rem;
    margin-top: -0.5rem;
  }
  .items {
    display: grid;
    gap: 0.5rem;
  }
  .item {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-card);
  }
  .item[data-s='planned'] {
    opacity: 0.62;
  }
  .item[data-s='done'] {
    border-color: color-mix(in srgb, var(--ok) 35%, var(--line));
  }
  .badge {
    flex-shrink: 0;
    font-size: 0.72rem;
    padding: 0.12rem 0.5rem;
    border-radius: 20px;
    border: 1px solid var(--line);
    color: var(--fg-dim);
    margin-top: 0.18rem;
  }
  .item[data-s='done'] .badge {
    border-color: var(--ok);
    color: var(--ok);
    background: var(--ok-bg);
  }
  .item[data-s='writing'] .badge {
    border-color: var(--warn);
    color: var(--warn);
    background: var(--warn-bg);
  }
  .item-b {
    flex: 1;
    line-height: 1.55;
  }
  .item-t {
    font-size: 0.98rem;
  }
  .item-q {
    font-size: 0.88rem;
  }
  .item-s {
    font-size: 0.8rem;
    font-family: var(--mono);
    margin-top: 0.25rem;
  }
  .contrib {
    margin-top: 3rem;
  }
  .contrib p {
    font-size: 0.93rem;
    color: var(--fg-muted);
  }
  .sysmap {
    margin: 2.2rem 0 2.8rem;
    padding: 1.2rem 1.1rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-card);
  }
  .sysmap > .goal {
    margin-top: 0.35rem;
    margin-bottom: 1.1rem;
  }
  .sys-h {
    font-size: 0.95rem;
    margin: 1.1rem 0 0.55rem;
  }
  .arch {
    display: grid;
    gap: 0.45rem;
  }
  .arch-node {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--line-soft);
  }
  .arch-n {
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font: 0.72rem var(--mono);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
  }
  .arch-node b {
    display: inline;
    margin-right: 0.45rem;
  }
  .standing {
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .arch-node p {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    color: var(--fg-muted);
  }
  .flow {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.45rem;
  }
  .flow li {
    padding: 0.65rem 0.7rem;
    border-radius: 8px;
    border: 1px dashed var(--line);
    background: var(--bg);
  }
  .flow b {
    display: block;
    font-size: 0.86rem;
    margin-bottom: 0.2rem;
  }
  .flow span {
    font-size: 0.78rem;
    color: var(--fg-muted);
    line-height: 1.45;
  }
  .ops {
    display: grid;
    gap: 0.45rem;
  }
  .ops-row {
    display: grid;
    gap: 0.15rem;
    padding: 0.55rem 0.1rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .ops-row:last-child {
    border-bottom: 0;
  }
  .ops-row span {
    font-size: 0.88rem;
  }
  @media (max-width: 560px) {
    .sysmap {
      padding: 1rem 0.85rem;
    }
  }
</style>
