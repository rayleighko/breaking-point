{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breaking-point-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-03",
  "vars": {
    "ALLOWED_ORIGIN": "https://rayleighko.github.io",
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
